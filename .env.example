# Django
DEBUG=True
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION
ALLOWED_HOSTS=127.0.0.1,localhost

# Ma'lumotlar bazasi
#
# True  -> SQLite (hech narsa o'rnatish shart emas, darhol ishga tushadi)
# False -> quyidagi PostgreSQL sozlamalari ishlatiladi
#
# PostgreSQL o'rnatib, unga o'tmoqchi bo'lsangiz, shu qatorni False qiling.
USE_SQLITE=True

# PostgreSQL (USE_SQLITE=False bo'lganda ishlatiladi)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kutubxona_db
DB_USER=kutubxona_user
DB_PASSWORD=kutubxona_pass123
DB_HOST=127.0.0.1
DB_PORT=5432

# Administrator bilan bog'lanish (sozlamalar sahifasidagi havola)
ADMIN_TELEGRAM_URL=https://t.me/Saidansaf001

# --- Redis (ixtiyoriy) ---
#
# Bo'sh qoldirsangiz loyiha xotiradagi keshda ishlaydi - hech narsa
# o'rnatish shart emas. Redis o'rnatilgan bo'lsa quyidagi qatorni oching:
#
#   REDIS_URL=redis://127.0.0.1:6379/1
#
# Redis nima beradi: bosh sahifa va katalog keshlanadi (bazaga so'rov
# ketmaydi), sessiyalar tezlashadi, AI so'rovlari chegarasi barcha
# jarayonlar uchun umumiy bo'ladi.
REDIS_URL=

# Keshda saqlash muddati (soniya)
CACHE_TIMEOUT_HOME=300
CACHE_TIMEOUT_CATALOG=180

# --- AI so'rovlari chegarasi ---
# Bitta foydalanuvchi bir oynada nechta so'rov yubora oladi.
# Bepul API kalitining limitini bir odam tugatib qo'ymasligi uchun.
AI_RATE_LIMIT_MESSAGES=30
AI_RATE_LIMIT_IMAGES=10
AI_RATE_LIMIT_WINDOW=3600

# --- Sun'iy intellekt (AI) ---
# Bepul API kaliti qayerdan olinadi:
#   Gemini     -> https://aistudio.google.com/apikey   (tavsiya etiladi, bepul)
#   Groq       -> https://console.groq.com/keys        (bepul, juda tez)
#   OpenRouter -> https://openrouter.ai/keys           (bepul modellar bor)
# Kalitni olib, AI_API_KEY ga qo'ying va AI_PROVIDER ni mos qiymatga sozlang.
AI_PROVIDER=gemini
AI_API_KEY=
# Modelni o'zgartirmoqchi bo'lsangiz (bo'sh qoldirsangiz standarti ishlatiladi):
AI_MODEL=

# Rasm generatsiyasi - Pollinations kalit talab qilmaydi, shundayligicha ishlaydi.
AI_IMAGE_PROVIDER=pollinations

# --- Email (parolni tiklash uchun) ---
# Bo'sh qoldirsangiz ham loyiha ishlaydi: DEBUG rejimida tiklash havolasi
# ekranda ko'rsatiladi. Haqiqiy xat yuborish uchun Gmail bilan:
#   https://myaccount.google.com/apppasswords dan "App password" oling
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Boshlang'ich super-admin (python manage.py seed_admin buyrug'i orqali yaratiladi)
ADMIN_USERNAME=Saidansaf
ADMIN_PASSWORD=@saidansaf.com123googlebu_meni_kuchli_parolim
ADMIN_EMAIL=admin@kutubxona.uz
# 1 qilinsa, seed_admin mavjud hisobning parolini ham ADMIN_PASSWORD ga
# tenglashtiradi. Parolni tiklab olgach 0 ga qaytaring — aks holda parol
# har ishga tushirishda qaytadan tiklanaveradi.
ADMIN_RESET_PASSWORD=0

# --- Telegram bot (ixtiyoriy) ---
#
# Token @BotFather dan olinadi:
#   1. Telegram'da @BotFather ni oching
#   2. /newbot yozing, botga nom va username bering
#   3. Bergan tokenini shu yerga qo'ying
#
# Bo'sh qoldirilsa bot ishga tushmaydi, sayt esa to'liq ishlayveradi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Botdagi havolalar shu manzilga olib boradi.
# Serverga joylashtirganda haqiqiy manzilni yozing.
SITE_URL=http://127.0.0.1:8000
